<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Capacitor applies this theme inside BridgeActivity after MainActivity's
         onCreate. Defining it here overrides Capacitor's blank default so the
         whole native window, including transparent Android system bars, belongs
         to Yose's Project instead of Nothing OS's dynamic colour. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#050706</item>
        <item name="android:statusBarColor">#050706</item>
        <item name="android:navigationBarColor">#050706</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Android 15/16 forces transparent system bars.  Their visible area
             therefore comes from the window background, not statusBarColor. -->
        <item name="android:windowBackground">#050706</item>
        <item name="android:statusBarColor">#050706</item>
        <item name="android:navigationBarColor">#050706</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#050706</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#050706</item>
        <item name="android:navigationBarColor">#050706</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
